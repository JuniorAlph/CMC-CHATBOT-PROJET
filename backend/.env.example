# MongoDB Atlas (URI de production)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGO_DB=cmc_chatbot

# URL publique HTTPS de votre instance AnythingLLM (pas localhost)
ANYTHINGLLM_URL=https://<votre-instance-anythingllm>
ANYTHINGLLM_KEY=<votre-cle-api>
ANYTHINGLLM_WORKSPACE=<slug-workspace>

# Origines autorisées, séparées par des virgules
ALLOWED_ORIGINS=https://<votre-domaine-vercel>.vercel.app
